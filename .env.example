# ─────────────────────────────────────────────────────────────
# Credenciales de Supabase
# Cópialo a un archivo llamado  .env  y reemplaza los valores.
# Los obtienes en: Supabase > Project Settings > API
# ─────────────────────────────────────────────────────────────

# URL del proyecto (ej: https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=

# Clave pública "anon" (NO la service_role)
VITE_SUPABASE_ANON_KEY=
